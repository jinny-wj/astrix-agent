{
  "name": "m0-local-reconstruction",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Local reconstruction using recovered M0 AI frontend assets and a replaceable local backend",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:plugins": "node plugins/prepare.mjs",
    "prepare:frontend": "node plugins/prepare.mjs && node frontend-tools/prepare-frontend.mjs",
    "start": "node scripts/start.mjs",
    "start:web": "node server/index.mjs",
    "desktop": "electron .",
    "desktop:figma": "electron tools/open-figma-workspace.cjs",
    "release": "node tools/publish-version.mjs",
    "release:runtime": "node tools/package-runtime.mjs",
    "test:figma": "node --test test/figma-*.test.mjs && node tools/test-figma-host-policy.cjs",
    "test:figma-ui": "electron tools/test-real-figma-integration.cjs",
    "test": "node --test test/*.test.mjs canvas/vector.test.mjs canvas/collaboration-state.test.mjs && node tools/test-figma-host-policy.cjs && node tools/test-marketplace-policy.cjs && node tools/test-local-navigation.cjs && node plugins/test-generators.mjs && node canvas/test-canvas.mjs",
    "test:ui": "electron scripts/ui-check.cjs",
    "analyze:rea": "node tools/run-rea.mjs",
    "editor:original": "electron tools/open-authentic-editor.cjs --run --interactive",
    "test:preview": "electron scripts/preview-check.cjs",
    "test:canvas": "node canvas/test-canvas.mjs && node --test canvas/vector.test.mjs",
    "test:canvas-ui": "node scripts/canvas-check.mjs",
    "test:prototype-ui": "electron scripts/design-preview-check.cjs",
    "test:design-cloud-ui": "electron scripts/design-cloud-check.cjs",
    "test:marketplace-ui": "electron tools/test-native-editor-marketplace.cjs",
    "test:marketplace-policy": "node tools/test-marketplace-policy.cjs",
    "test:workflow-ui": "electron scripts/workflow-check.cjs",
    "test:collaboration": "node --test test/canvas-collaboration.test.mjs canvas/collaboration-state.test.mjs",
    "test:collaboration-ui": "node scripts/canvas-check.mjs --collaboration",
    "release:resources": "node tools/package-resources.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "38.7.2"
  }
}
