{
  "name": "Design Studio Bridge",
  "id": "design-studio-wj-bridge",
  "api": "1.0.0",
  "enablePrivatePluginApi": true,
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma"],
  "documentAccess": "dynamic-page",
