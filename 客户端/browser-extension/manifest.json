{
  "manifest_version": 3,
  "name": "Design Agent for Figma",
  "version": "0.3.2",
  "description": "在 Figma 设计页旁打开独立的 Agent 与 Skill 工作区。",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "declarativeContent",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5273/*",
    "http://localhost:5273/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开 Design Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5273/*",
        "http://localhost:5273/*"
      ],
      "js": [
        "workspace-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.figma.com/design/*"
      ],
      "js": [
        "figma-page-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "agent-frame.html"
      ],
      "matches": [
        "https://www.figma.com/*"
      ]
    }
  ]
}
