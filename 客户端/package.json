{
  "name": "design-studio-wj-desktop",
  "description": "Design Studio WJ macOS 客户端",
  "author": "Design Studio WJ",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "test": "node --experimental-strip-types --test server/*.test.ts server/agent/*.test.ts src/services/*.test.ts browser-extension/*.test.js desktop/*.test.ts desktop/*.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:figma-bridge": "node --experimental-strip-types --test server/figmaBridgePlugin.test.ts server/figmaInstruction.test.ts server/webCapture.test.ts",
    "test:figma-oauth-config": "node --experimental-strip-types --test server/figmaOAuthConfig.test.ts",
    "test:figma-layer": "node --experimental-strip-types --test src/services/figmaLayer.test.ts",
    "test:agent-composer": "node --experimental-strip-types --test server/agent/composer.test.ts server/agent/runtimePolicy.test.ts",
    "preview": "vite preview",
    "desktop:typecheck": "tsc -p tsconfig.desktop.json",
    "desktop:bundle": "node scripts/build-desktop.mjs",
    "desktop:dev": "pnpm run build && pnpm run desktop:typecheck && pnpm run desktop:bundle && electron .",
    "desktop:sign:mac": "node scripts/sign-mac-local.mjs",
    "desktop:pack:mac": "pnpm run build && pnpm run desktop:typecheck && pnpm run desktop:bundle && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 && pnpm run desktop:sign:mac && pnpm run desktop:verify:mac:local",
    "desktop:dist:mac:local": "pnpm run desktop:pack:mac && electron-builder --mac dmg zip --arm64 --prepackaged 'release/mac-arm64/Design Studio.app'",
    "desktop:release:preflight": "node scripts/preflight-mac-release.mjs",
    "desktop:release:mac": "pnpm run desktop:release:preflight && pnpm run build && pnpm run desktop:typecheck && pnpm run desktop:bundle && electron-builder --mac dmg zip --universal -c.forceCodeSigning=true -c.mac.notarize=true && pnpm run desktop:verify:mac:release",
    "desktop:dist:mac": "pnpm run desktop:release:mac",
    "desktop:verify:mac:local": "node scripts/verify-mac-release.mjs --mode=local --app='release/mac-arm64/Design Studio.app'",
    "desktop:verify:mac:release": "node scripts/verify-mac-release.mjs --mode=distribution --app='release/mac-universal/Design Studio.app'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.wj.designstudio",
    "productName": "Design Studio",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/claude"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "desktop/renderer/**/*",
      "browser-extension/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/astrix.icns",
        "to": "astrix.icns"
      },
      {
        "from": "skills",
        "to": "agent-resources/skills"
      },
      {
        "from": "AGENTS.md",
        "to": "agent-resources/AGENTS.md"
      },
      {
        "from": "figma-plugin-bridge",
        "to": "figma-plugin-bridge",
        "filter": [
          "manifest.json",
          "code.js",
          "ui.html",
          "README.md"
        ]
      }
    ],
    "mac": {
      "extendInfo": {
        "CFBundleIconFile": "astrix.icns"
      },
      "category": "public.app-category.graphics-design",
      "minimumSystemVersion": "13.0",
      "icon": "build/astrix.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dir"
      ]
    },
    "dmg": {
      "sign": false
    }
  }
}
