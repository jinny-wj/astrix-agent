# 在 https://www.figma.com/developers/apps 创建 OAuth App 后填写。
# Client Secret 只能保存在服务端环境变量中，不能使用 VITE_ 前缀。
# 基础连接仅需启用 current_user:read、file_content:read、file_metadata:read。
# 团队目录读取是独立能力，不应向未启用的应用请求 projects:read。
# 回调地址必须与 Figma Developer Console 中登记的地址完全一致。
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=http://127.0.0.1:5273/api/auth/figma/callback

# 可选初始 team_id（也可在首页「团队设置」中保存，逗号分隔多个）
FIGMA_TEAM_IDS=

# Agent 后端
# auto   = 优先本机 Codex CLI，失败再试 Claude Code / Hermes；不会自动伪造结果
# codex  = 强制 Codex CLI（openai/codex）
# claude = 强制 Claude Code Agent SDK
# hermes = 强制 Hermes（NousResearch/hermes-agent）
# shell  = 显式启用说明性演示壳子（不会假装生成了素材）
AGENT_BACKEND=auto
AGENT_MODEL=auto
# 默认不让真实 Agent 失败时伪造生成结果；仅产品演示时显式开启。
AGENT_ALLOW_DEMO_FALLBACK=0

# 人物战报图生图通道（不要把真实密钥提交进仓库）
SEEDREAM_API_KEY=
GEMINI_API_KEY=
GEMINI_GATEWAY_COOKIE=
KCDN_TOKEN=
